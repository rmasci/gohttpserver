#!/bin/bash

### BEGIN INIT INFO
# Provides:          sdn-chatbot
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: sdn-chatbot
# Description:       sdn-chatbot
### END INIT INFO

# Installation
# - Move this to /etc/init.d/myservice
# - chmod +x this
#
# Starting and stopping
# - Start: `service myservice start` or `/etc/init.d/myservice start`
# - Stop: `service myservice stop` or `/etc/init.d/myservice stop`

#ref http://till.klampaeckel.de/blog/archives/94-start-stop-daemon,-Gearman-and-a-little-PHP.html
#ref http://unix.stackexchange.com/questions/85033/use-start-stop-daemon-for-a-php-server/85570#85570
#ref http://serverfault.com/questions/229759/launching-a-php-daemon-from-an-lsb-init-script-w-start-stop-daemon

NAME="HttpFS"
DESC="HTTP File Server"
PIDFILE="/var/run/${NAME}.pid"
LOGFILE="/var/log/${NAME}.log"
UERNAME="rx7322"
DAEMON="/usr/local/sbin/gohttpserver"
DAEMON_OPTS="-r /var/www/html/ --port=48000 --delete --xheaders --google-tracker-id="" --upload --title=Bespinwerks --cert /etc/ssl/chatbot/bespinwerks.web.att.com.crt --key /etc/ssl/chatbot/bespinwerks.web.att.com.key"

# --key /var/www/bespinwerks.key --cert /var/www/bespinwerks.cert"

test -x $DAEMON || exit 0

set -e

function startdaemon() {
        echo -n "Starting $DESC: "
	start-stop-daemon --start --background --quiet --oknodo --chuid 0:0 --pidfile $PIDFILE --exec $DAEMON -- $DAEMON_OPTS >> $LOGFILE 2>&1  && echo "Started gohttpd PID: `pgrep $DAEMON`" || echo "Not Started"
	pgrep $DAEMON > $PIDFILE
	echo
}

function stopdaemon() {
        echo -n "Stopping $DESC: "
        start-stop-daemon --stop --quiet --oknodo --pidfile $PIDFILE --exec $DAEMON
        rm -f $PIDFILE
	echo
}

case "$1" in
    start)
	startdaemon
        ;;
    stop)
	stopdaemon
        ;;
    restart|force-reload)
	stopdaemon
	startdaemon
        ;;
    *)
        N=/etc/init.d/$NAME
        echo "Usage: $N {start|stop|restart|force-reload}" >&2
        exit 1
        ;;
esac

exit 0

#!/bin/bash
### BEGIN INIT INFO
# Provides:          gohttpserver
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: GoHTTPServer - Bespinwerks File Server
### END INIT INFO

SERVICE="gohttpd"

case "$1" in
    start)
        echo "Running: sudo systemctl start ${SERVICE}"
        sudo systemctl start ${SERVICE}
        echo "Running: sudo systemctl status ${SERVICE}"
        sudo systemctl status ${SERVICE}
        ;;
    stop)
        echo "Running: sudo systemctl stop ${SERVICE}"
        sudo systemctl stop ${SERVICE}
        echo "Running: sudo systemctl status ${SERVICE}"
        sudo systemctl status ${SERVICE}
        ;;
    restart)
        echo "Running: sudo systemctl restart ${SERVICE}"
        sudo systemctl restart ${SERVICE}
        echo "Running: sudo systemctl status ${SERVICE}"
        sudo systemctl status ${SERVICE}
        ;;
    status)
        echo "Running: sudo systemctl status ${SERVICE}"
        sudo systemctl status ${SERVICE}
        ;;
    logs)
        echo "Running: sudo journalctl -u ${SERVICE} -f"
        sudo journalctl -u ${SERVICE} -f
        ;;
    enable)
        echo "Running: sudo systemctl enable ${SERVICE}"
        sudo systemctl enable ${SERVICE}
        ;;
    disable)
        echo "Running: sudo systemctl disable ${SERVICE}"
        sudo systemctl disable ${SERVICE}
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|enable|disable}"
        exit 1
        ;;
esac

exit $?
